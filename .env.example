# Server-side only. Copy these names to .env.local locally.
# Do NOT commit .env.local or actual credentials.
# Configure the same values on your production deployment.
OPENAI_API_KEY=
# Optional; supported Responses API model, default gpt-4.1-mini.
OPENAI_ASSISTANT_MODEL=gpt-4.1-mini

# Neon: use a POOLED connection string for the 'aquamazone' database,
# authenticated as the least-privilege 'aquamazone_app_read' role.
# Never paste credentials into chat, Git or browser code.
DATABASE_URL_READONLY=

# --- Private admin dashboard (run 'npm run setup:admin' locally) ---
# The setup script generates these values securely in .env.local.
ADMIN_AUTH_ENABLED=
ADMIN_PASSWORD_SCRYPT=
ADMIN_SESSION_SECRET=

# Neon: scoped 'aquamazone_intake' role.
# Sole admin can log WhatsApp enquiries, NEVER confirmed bookings.
DATABASE_URL_INTAKE=

# Neon: restricted 'aquamazone_hold_worker' role; private 10-minute equipment holds.
# Never reuse the administrator/intake connection string for this role.
DATABASE_URL_HOLDS=

# --- Customer contact verification ---
# Scoped Neon role aquamazone_contact_verify, database aquamazone.
DATABASE_URL_CONTACT_VERIFICATION=
# Private >=32-character HMAC secret (npm run setup:contact).
CONTACT_OTP_SECRET=
# Verified Resend sender domain.
CONTACT_EMAIL_FROM=
# Approved WhatsApp AUTHENTICATION COPY_CODE template.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=fr
WHATSAPP_GRAPH_VERSION=v26.0

# Neon: restricted 'aquamazone_alert_worker' role.
# Allows queue SELECT/UPDATE only, never reservations modifications.
DATABASE_URL_ALERTS=

# Email alerts: verify the sender domain in Resend.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# WhatsApp alerts: use approved Meta WhatsApp Business Cloud API utility template.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_TO=
WHATSAPP_ALERT_TEMPLATE_NAME=
WHATSAPP_ALERT_TEMPLATE_LANGUAGE=fr

# 32+ character random secret for the scheduled dispatcher.
# The admin setup script generates this locally if absent.
ALERT_CRON_SECRET=

# --- MTN MoMo Collections (NOT active until official Benin merchant onboarding) ---
# Disabled by default. Never commit live API credentials.
# sandbox is for test EUR payments; mtnbenin is the production XOF environment.
MTN_MOMO_ENABLED=false
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
# HTTPS callback host must be registered with MTN before use.
MTN_MOMO_CALLBACK_URL=
